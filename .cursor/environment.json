{
  "name": "live-political-analysis",
  "install": "bash .cursor/install.sh",
  "ports": [
    {
      "name": "PolitikKu dev server",
      "port": 4178
    }
  ],
  "terminals": [
    {
      "name": "dashboard",
      "command": "export DATABASE_URL=\"sqlite+pysqlite:///$PWD/lpa.db\"; .venv/bin/streamlit run src/lpa/dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
    },
    {
      "name": "site-dev",
      "command": "cd frontend && npm run dev"
    }
  ]
}
