__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
dist/
*.db

# Never commit a database credential. The setup wizard does not write one
# here, but nothing should be able to arrive in the repo by accident.
# `.env` alone does not match `.env.agent` or any other suffixed variant —
# the glob is what makes "put the key in a dotfile next to the code" safe by
# default rather than safe only for the one filename someone thought of.
.env
.env.*
.streamlit/secrets.toml

# Finder writes these into any directory it opens, and one reached a commit
# before this line existed.
.DS_Store

# Rendered by `python -m lpa.politikku_landing` (the landing page owns the
# site root since the landing-page cutover — `lpa.politikku_homepage` owned
# it from #104 until then, and `lpa.public_page` before that; neither is
# rendered or published at this path any more); the Action publishes it,
# the repo does not carry it.
public/index.html
public/ms/index.html

# Rendered by `python -m lpa.politikku_homepage` — moved off the site root
# to `public/home.html` (the "Dashboard" nav page) at the same cutover.
public/home.html
public/ms/home.html

# Rendered by `python -m lpa.public_export`, alongside index.html — same
# reasoning: the Action publishes it, the repo does not carry it.
public/projection.json
public/projection.csv

# Rendered by `python -m lpa.seat_call_card --all`, one SVG per Seat Call —
# same reasoning again.
public/cards/

# PolitikKu's other pages (#75/#79/#102) and their generated data — same
# reasoning as public/index.html above: rendered by `python -m
# lpa.politikku_mp_profile`/`politikku_projection`, not carried in the
# repo. Never had an explicit entry until #77 added lookup.js/
# lookup-index.json alongside them, which is also when this gap (the
# earlier three pages relying on nobody ever `git add -A`-ing them) was
# noticed and closed. Every path here moved out from under
# `public/politikku/` in #104's cutover. (`public/landing.html`/
# `public/ms/landing.html` used to be listed here too, before the
# landing-page cutover moved that output to `public/index.html` above.)
public/bills.html
public/ms/bills.html
public/methodology.html
public/ms/methodology.html
public/mp/
public/ms/mp/
public/data/
# The projection page (#102) itself, but deliberately *not* the dated
# permalinks written beside it (public/projection/<year>/<month>/<day>.html)
# — see the #55 note further down, which those files are the whole point of.
public/projection/index.html
public/projection/ms/index.html

# ts/src/lookup.ts's compiled output (#77, `node build.mjs`) — generated,
# not committed, the same call already made for the Python-rendered pages
# above. ts/ itself (source, package.json, tests) is tracked normally.
public/lookup.js
public/lookup.js.map
node_modules/

# Generated learn pages (migrated to python renderers)
public/learn/*.html
public/ms/learn/*.html

# public/projection/<year>/<month>/<day>.html (#55) is also tracked,
# deliberately — the path moved with the content in #102/#104, but not the
# reasoning —
# unlike index.html above, a dated permalink's whole point is to survive
# past today. deploy-pages replaces the live site wholesale on every run
# rather than merging into it, so a gitignored dated file would vanish the
# moment the next day's Action deployed — the same problem #55 exists to
# solve, just one day later. Committed by daily.yml's "Archive the dated
# permalink" step instead, so a fresh checkout always has every past day's
# file to publish alongside the new one.

# Diagnostic output from `lpa.citation_check` for a claim the automated
# judge couldn't resolve (see docs/agents/citation-check.md) — written next
# to the page it checked, not meant to be committed.
public/learn/*.pending.json

# Local Claude Code state — machine-specific settings and scheduled-task
# locks, not project content. The skills themselves live in ~/.claude/skills;
# nothing under .claude/ belongs in the repo (we did not vendor skills into
# it; see the CI-gate decision).
.claude/

# Working directories for scripts/deepseek_agent.py runs — a linked git
# worktree plus its transcript per run, kept by default for post-hoc review
# (see docs/agents/deepseek-agent.md). Diagnostic/working output, same as
# public/learn/*.pending.json above: written next to what it's about, not
# meant to be committed.
.deepseek-agent-runs/
public/sitemap.xml

# Sentiment page
public/sentiment.html
public/ms/sentiment.html
