__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
dist/
*.db

# Never commit a database credential. The setup wizard does not write one
# here, but nothing should be able to arrive in the repo by accident.
.env
.streamlit/secrets.toml

# Finder writes these into any directory it opens, and one reached a commit
# before this line existed.
.DS_Store

# Rendered by `python -m lpa.public_page`; the Action publishes it, the repo
# does not carry it.
public/index.html

# Rendered by `python -m lpa.public_export`, alongside index.html — same
# reasoning: the Action publishes it, the repo does not carry it.
public/projection.json
public/projection.csv

# Rendered by `python -m lpa.seat_call_card --all`, one SVG per Seat Call —
# same reasoning again.
public/cards/

# public/learn/ is different: hand-authored content pages (#26/#27/#28), not
# generated. They are tracked so the daily Action's checkout has them to
# publish alongside the freshly-rendered index.html — see daily.yml's
# "Upload the page" step, which uploads the whole public/ directory.

# public/<year>/<month>/<day>.html (#55) is also tracked, deliberately —
# unlike index.html above, a dated permalink's whole point is to survive
# past today. deploy-pages replaces the live site wholesale on every run
# rather than merging into it, so a gitignored dated file would vanish the
# moment the next day's Action deployed — the same problem #55 exists to
# solve, just one day later. Committed by daily.yml's "Archive the dated
# permalink" step instead, so a fresh checkout always has every past day's
# file to publish alongside the new one.

# Diagnostic output from `lpa.citation_check` for a claim the automated
# judge couldn't resolve (see docs/agents/citation-check.md) — written next
# to the page it checked, not meant to be committed.
public/learn/*.pending.json

# Local Claude Code state — machine-specific settings and scheduled-task
# locks, not project content. The skills themselves live in ~/.claude/skills;
# nothing under .claude/ belongs in the repo (we did not vendor skills into
# it; see the CI-gate decision).
.claude/

# Working directories for scripts/deepseek_agent.py runs — a linked git
# worktree plus its transcript per run, kept by default for post-hoc review
# (see docs/agents/deepseek-agent.md). Diagnostic/working output, same as
# public/learn/*.pending.json above: written next to what it's about, not
# meant to be committed.
.deepseek-agent-runs/
