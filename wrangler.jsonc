{
  // MyPolitik — static map app on Cloudflare Workers (assets) + tiny worker.
  // Public/deploy name is "mypolitik".
  "name": "mypolitik",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "mypolitik.xyz", "custom_domain": true },
    { "pattern": "www.mypolitik.xyz", "custom_domain": true },
    { "pattern": "mypolitik.krackeddevs.com", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "mypolitik-staging",
      "main": "worker.js",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "observability": { "enabled": true },
      "routes": [
        { "pattern": "staging.mypolitik.krackeddevs.com", "custom_domain": true }
      ]
    }
  }
}
